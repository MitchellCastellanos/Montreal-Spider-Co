# Copy this file to `.env.local` and fill in the values.
# See SETUP_DATABASE.md for step-by-step instructions (Neon + Cloudinary).

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave empty until you have real Neon credentials (storefront falls back to seed catalog).
# Prisma needs BOTH when you connect:
#   DATABASE_URL = pooled  (host contains `-pooler`)
#   DIRECT_URL   = direct  (same host, no `-pooler`)
DATABASE_URL=
DIRECT_URL=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=montreal-spider-co/products

ADMIN_PASSWORD=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Stripe — https://dashboard.stripe.com/apikeys (test keys for local dev)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret — from `stripe listen` locally or Stripe Dashboard → Webhooks
STRIPE_WEBHOOK_SECRET=

# Resend — outbound email, routed by purpose so each stream sends from its own address
# (https://resend.com). All addresses must be on a domain verified in Resend.
RESEND_API_KEY=
# Customer order lifecycle (confirmation, pickup ready/reminders, cancellations, refunds…).
RESEND_FROM_EMAIL=orders@montrealspider.ca
# Account mail (welcome, password reset). Defaults to hello@montrealspider.ca.
RESEND_ACCOUNT_FROM_EMAIL=hello@montrealspider.ca
# Contact-form auto-reply. Defaults to contact@montrealspider.ca.
RESEND_CONTACT_FROM_EMAIL=contact@montrealspider.ca
# Distributor/partner-facing emails (statements, restocks, audits, invitations…). Defaults to RESEND_FROM_EMAIL.
RESEND_PARTNER_FROM_EMAIL=partners@montrealspider.ca
# Internal staff reports/alerts (new order, contact message, restock awaiting, SEO audit…). Defaults to reports@montrealspider.ca.
RESEND_REPORTS_FROM_EMAIL=reports@montrealspider.ca
# Where staff alerts/reports are received, and BCC'd whenever a message goes out to a distributor. Defaults to hello@montrealspider.ca.
ORDERS_ADMIN_EMAIL=hello@montrealspider.ca

# Cron auth — required header on /api/cron/* routes (fulfillment sweep, weekly SEO audit).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# IndexNow (https://www.indexnow.org) — instant recrawl pings to Bing/Yandex when a
# product is created/updated/deleted. Optional; leave empty to skip.
# Generate any random hex string, e.g.: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
INDEXNOW_KEY=
