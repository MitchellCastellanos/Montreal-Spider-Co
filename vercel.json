{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": ["yul1"],
  "crons": [
    {
      "path": "/api/cron/fulfillment",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/seo-audit",
      "schedule": "0 12 * * 1"
    }
  ]
}
